# Copy this file to dev.env for local E2E testing. dev.env is ignored by Git.
# Template simulated link: a virtual loopback pair connecting COM1 <-> COM2.
# Reverse these roles for the opposite-direction scenario, or override both
# values with a real hardware loopback pair when explicitly testing hardware.
QSERIAL_E2E_TX_PORT=COM1
QSERIAL_E2E_RX_PORT=COM2
